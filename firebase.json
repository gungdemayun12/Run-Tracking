{
  "firestore": {
    "rules": "app/firebase/firestore.rules",
    "indexes": "app/firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": "web/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/reset-password",
        "destination": "/reset-password/index.html"
      },
      {
        "source": "/__/auth/action",
        "destination": "/reset-password/index.html"
      }
    ]
  }
}
