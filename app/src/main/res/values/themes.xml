<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.RunTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/window_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/window_light_system_bars</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialCardViewStyle">@style/Widget.RunTrack.Card</item>
        <item name="materialButtonStyle">@style/Widget.RunTrack.Button</item>
        <item name="textInputStyle">@style/Widget.RunTrack.TextInputLayout</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.RunTrack.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RunTrack.AlertDialog</item>
    </style>

    <style name="Theme.RunTrack" parent="Base.Theme.RunTrack" />

    <!-- Dark window background so a cold start never flashes a white screen
         before the first splash frame is drawn. -->
    <style name="Theme.RunTrack.Splash" parent="Theme.RunTrack">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.RunTrack.Auth" parent="Theme.RunTrack">
        <item name="android:windowBackground">@color/auth_bg</item>
        <item name="android:statusBarColor">@color/auth_bg</item>
        <item name="android:navigationBarColor">@color/auth_sheet</item>
        <item name="android:windowLightStatusBar">@bool/window_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_system_bars</item>
        <item name="colorSurface">@color/auth_sheet</item>
        <item name="colorOnSurface">@color/auth_text_primary</item>
        <item name="android:textColorPrimary">@color/auth_text_primary</item>
        <item name="android:textColorHint">@color/auth_text_hint</item>
    </style>

    <!-- Translucent snapshot cover used while dark/light mode is switched. -->
    <style name="Theme.RunTrack.Transition" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Widget.RunTrack.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.RunTrack.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.RunTrack.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/auth_input</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxStrokeColor">@color/brand</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="errorTextColor">@color/danger</item>
        <item name="errorIconTint">@color/danger</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.RunTrack.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.RunTrack.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.RunTrack.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.RunTrack.SettingTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.RunTrack.SettingSub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.RunTrack.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">18dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="chipBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.RunTrack.ChipFilter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">18dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconTint">@color/brand</item>
        <item name="chipIconTint">@color/brand</item>
        <item name="rippleColor">@color/brand_20</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.RunTrack.AuthField" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/auth_input</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxStrokeColor">@color/auth_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/danger</item>
        <item name="errorIconTint">@color/danger</item>
        <item name="startIconTint">@color/auth_icon</item>
        <item name="endIconTint">@color/auth_icon</item>
        <item name="hintTextColor">@color/auth_text_hint</item>
    </style>

    <style name="ShapeAppearance.RunTrack.Circle" parent="ShapeAppearance.Material3.Corner.Full" />

    <style name="ShapeAppearance.RunTrack.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.RunTrack.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RunTrack.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.RunTrack.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.RunTrack.BottomSheet</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="ThemeOverlay.RunTrack.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:background">@color/surface</item>
    </style>
</resources>
