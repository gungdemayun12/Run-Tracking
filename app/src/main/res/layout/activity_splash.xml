<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fitsSystemWindows="true">

    <!-- Ambient brand glow -->
    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-160dp"
        android:layout_marginEnd="-130dp"
        android:alpha="0.55"
        android:background="@drawable/bg_glow_orange" />

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-130dp"
        android:layout_marginBottom="-120dp"
        android:alpha="0.35"
        android:background="@drawable/bg_glow_orange" />

    <!-- Faint speed lines -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="-120dp"
        android:background="@drawable/bg_gradient_top_dark"
        android:alpha="0.6" />

    <!-- Center hero -->
    <LinearLayout
        android:id="@+id/splash_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:id="@+id/logo_container"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center">

            <com.example.runtrack.ui.widget.RunnerLoaderView
                android:id="@+id/runner_loader"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:alpha="0.20"
                android:background="@drawable/bg_gradient_brand_circle" />

            <View
                android:id="@+id/logo_pulse_halo"
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:layout_gravity="center"
                android:alpha="0.20"
                android:background="@drawable/bg_gradient_brand_circle" />

            <ImageView
                android:id="@+id/logo_splash"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/splash_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.16"
                android:text="RUNTRACK"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.34"
                android:text="ATHLETIC TRACKER"
                android:textColor="@color/run_orange"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Presisi setiap langkah.\nTaklukkan rute barumu."
            android:textColor="@color/white_70"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom loader + signature -->
    <LinearLayout
        android:id="@+id/splash_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <ProgressBar
            android:id="@+id/loading_progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="190dp"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/splash_progress" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="MEMPERSIAPKAN..."
                android:textAllCaps="true"
                android:textColor="@color/white_70"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0%"
                android:textColor="@color/run_orange"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_pill_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.04"
                android:text="Engineering by gungdev"
                android:textColor="#FFB99E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
