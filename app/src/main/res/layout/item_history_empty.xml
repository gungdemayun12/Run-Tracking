<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:minHeight="380dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="48dp"
    android:paddingEnd="20dp"
    android:paddingBottom="32dp">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_icon_brand">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="Belum ada riwayat"
            android:src="@drawable/ic_history"
            app:tint="@color/brand" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Belum ada riwayat"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_empty_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Setelah kamu selesai berlari, aktivitasmu akan muncul di sini."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
